      "title": "Aharon's line and the Levites in place of the firstborn",
      "movement": 1,
      "part": 1,
      "built": true,
      "roots": {
        "generations": {
          "color": "#55642f",
          "translit": "toledot",
          "gloss": "generations; a family line and its story",
          "example": "These are the generations of Aharon and Moshe",
          "echo": "Gen 2:4 — the heading that structures Genesis, used here for the priestly house; Ruth 4:18 runs it through Nachshon to David."
        },
        "anoint": {
          "color": "#3d6b4a",
          "translit": "mashaḥ",
          "gloss": "anoint, smear with oil"
        },
        "fill-hand": {
          "color": "#7a3f5c",
          "translit": "maleʾ",
          "gloss": "fill; with 'hand', install someone as priest",
          "example": "whose hand he filled to serve as priests",
          "echo": "Exod 32:29 — the Levites 'fill their hand' for Yahweh after the calf; Judg 17:5, 12 and 1 Kgs 13:33 — the same idiom at counterfeit shrines."
        },
        "given": {
          "color": "#1f6e7a",
          "translit": "natan",
          "gloss": "give; given over to another",
          "example": "given, given are they to him",
          "echo": "8:16 — 'given to me'; the 'given ones' return as temple servants 'given' for the Levites' service (Ezra 8:20)."
        },
        "priest": {
          "color": "#9c5a1e",
          "translit": "kohen",
          "gloss": "priest; serve as priest; priesthood",
