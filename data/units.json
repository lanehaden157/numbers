      "passage": "Numbers 1:1–54",
      "title": "The First Accounting",
      "movement": 1,
      "part": 1,
      "built": true,
      "roots": {
        "polls": {
          "color": "#55642f",
          "translit": "gulgolet",
          "gloss": "skull; hence a head counted, per person",
          "example": "every male, by their skulls",
          "echo": "Exod 30:12; 38:26 — the same per-head count, paid as a half-shekel ransom so that no plague strikes when Yisrael is counted"
        },
        "descent": {
          "color": "#3d6b4a",
          "translit": "yalad",
          "gloss": "bear, beget; here, register one’s lineage",
          "example": "they declared their descent by their clans"
        },
        "company": {
          "color": "#5a5a9c",
          "translit": "degel",
          "gloss": "company, the tribal unit camped under one standard; traditionally ‘banner’",
          "example": "each man by his company",
          "echo": "Song 2:4 — the only use outside Numbers, usually read ‘his banner over me is love’"
        }
      },
      "contract": "0.8.5"
    },
